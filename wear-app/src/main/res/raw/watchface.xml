<?xml version="1.0" encoding="utf-8"?>
<WatchFace xmlns="http://schemas.android.com/wear/watchface/format"
    version="1"
    width="450"
    height="450">

    <Metadata>
        <Key name="CLOCK_TYPE" value="DIGITAL"/>
        <Key name="PREVIEW_TIME" value="10:08:32"/>
    </Metadata>

    <Scene backgroundColor="#ff000000">

        <!-- Date: cyan -->
        <DigitalClock x="0" y="40" width="450" height="35">
            <TimeText format="EEE d MMM" align="CENTER">
                <Font family="SANS_SERIF_CONDENSED" size="21" color="#ff00e5ff" style="NORMAL"/>
            </TimeText>
        </DigitalClock>

        <!-- Time: gold bold condensed -->
        <DigitalClock x="0" y="78" width="450" height="110">
            <TimeText format="HH:mm" align="CENTER">
                <Font family="SANS_SERIF_CONDENSED" size="90" color="#ffffd700" style="BOLD"/>
            </TimeText>
        </DigitalClock>

        <!-- EUR/USD: wide SMALL_IMAGE bitmap (color-coded pip digits) -->
        <ComplicationSlot x="9" y="196" width="432" height="90"
            slotId="0"
            name="EURUSD"
            supportedTypes="SMALL_IMAGE">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.EurUsdComplicationService"
                type="SMALL_IMAGE"/>
        </ComplicationSlot>

        <!-- DXY: short text, left -->
        <ComplicationSlot x="18" y="295" width="145" height="30"
            slotId="1"
            name="DXY"
            supportedTypes="SHORT_TEXT">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.DxyComplicationService"
                type="SHORT_TEXT"/>
        </ComplicationSlot>

        <!-- BTC: short text, right -->
        <ComplicationSlot x="287" y="295" width="145" height="30"
            slotId="2"
            name="BTC"
            supportedTypes="SHORT_TEXT">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.BtcComplicationService"
                type="SHORT_TEXT"/>
        </ComplicationSlot>

        <!-- XETRA session circle: left -->
        <ComplicationSlot x="25" y="315" width="100" height="100"
            slotId="3"
            name="XETRA"
            supportedTypes="SMALL_IMAGE">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.XetraSessionComplicationService"
                type="SMALL_IMAGE"/>
        </ComplicationSlot>

        <!-- LSE session circle: centre -->
        <ComplicationSlot x="175" y="315" width="100" height="100"
            slotId="4"
            name="LSE"
            supportedTypes="SMALL_IMAGE">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.LseSessionComplicationService"
                type="SMALL_IMAGE"/>
        </ComplicationSlot>

        <!-- NYSE session circle: right -->
        <ComplicationSlot x="325" y="315" width="100" height="100"
            slotId="5"
            name="NYSE"
            supportedTypes="SMALL_IMAGE">
            <DefaultComplicationDataProvider
                providerId="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.NyseSessionComplicationService"
                type="SMALL_IMAGE"/>
        </ComplicationSlot>

    </Scene>

</WatchFace>
