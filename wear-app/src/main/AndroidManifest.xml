<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch"/>

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- The repeating alert buzz runs as a foreground service so it is exempt
         from Doze and keeps a steady 60s beat with the screen off. Chosen over
         AlarmManager because SCHEDULE_EXACT_ALARM is denied by default on this
         API level, which would have silently degraded the nag to ~9 minutes
         for anyone whose watch is not on the Doze whitelist. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- NO watch face service here. This module has Kotlin code, so it can
             never be a Watch Face Format bundle (hasCode must be false), and
             Wear OS 6 blocks programmatic watch faces outright. The face lives
             in :watchface-wff. This module is complication data ONLY. -->

        <!-- Tap-to-refresh (2026-07-30). Only ever triggered by this app's own
             PendingIntent (from a complication tap), never externally -
             exported="false". -->
        <receiver
            android:name=".wear.RefreshRequestReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.reddoor3.forexdial.wear.ACTION_REFRESH"/>
            </intent-filter>
        </receiver>

        <!-- Clears a fired price alert when the watch icon is tapped. Same
             as the refresh receiver: only ever fired by this app's own
             PendingIntent, so exported="false". -->
        <receiver
            android:name=".wear.AlertDismissReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.reddoor3.forexdial.wear.ACTION_ALERT_DISMISS"/>
            </intent-filter>
        </receiver>

        <!-- Repeating buzz for an unacknowledged alert. specialUse because no
             standard foregroundServiceType fits "nag the wearer until they
             acknowledge a price level" - it is not media, location or sync. -->
        <service
            android:name=".wear.AlertNagService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Repeating haptic reminder for an unacknowledged price alert"/>
        </service>

        <service
            android:name=".wear.ForexDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED"/>
            </intent-filter>
            <meta-data
                android:name="com.google.android.gms.wearable.DATA_PATH_PREFIXES"
                android:value="/forexdial/"/>
        </service>

        <service
            android:name=".wear.complication.EurUsdComplicationService"
            android:exported="true"
            android:label="@string/comp_eurusd_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SMALL_IMAGE,LONG_TEXT,SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.AlertComplicationService"
            android:exported="true"
            android:label="@string/comp_alert_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SMALL_IMAGE"/>
            <!-- 60s, not the 300s used by the price complications: this one
                 gates a time-sensitive alert, and the phone's data-change
                 push is unreliable on this device (confirmed 2026-07-29), so
                 this poll is the dependable floor on how late an alert can
                 surface. Cheap - it redraws a 44x129 bitmap. -->
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="60"/>
        </service>

        <service
            android:name=".wear.complication.TopRowComplicationService"
            android:exported="true"
            android:label="@string/comp_top_row_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SMALL_IMAGE"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.SessionRowComplicationService"
            android:exported="true"
            android:label="@string/comp_session_row_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SMALL_IMAGE"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="60"/>
        </service>

        <service
            android:name=".wear.complication.DxyComplicationService"
            android:exported="true"
            android:label="@string/comp_dxy_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.BtcComplicationService"
            android:exported="true"
            android:label="@string/comp_btc_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>




        <service
            android:name=".wear.complication.YieldSpreadComplicationService"
            android:exported="true"
            android:label="@string/comp_yield_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.EurUsdPipComplicationService"
            android:exported="true"
            android:label="@string/comp_eurusd_pip_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.EurUsdPipsComplicationService"
            android:exported="true"
            android:label="@string/comp_eurusd_pips_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="LONG_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

        <service
            android:name=".wear.complication.YieldDirectionComplicationService"
            android:exported="true"
            android:label="@string/comp_yield_dir_label">
            <intent-filter>
                <action android:name="androidx.wear.watchface.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
            </intent-filter>
            <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="SHORT_TEXT"/>
            <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
        </service>

    </application>
</manifest>
