<PartText x="0" y="294" width="450" height="36" alpha="255">
<Variant mode="AMBIENT" target="alpha" value="140"/>
<Text align="CENTER" ellipsis="FALSE">
<Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" slant="NORMAL" color="#ffffffff">
<Upper><Template>%s %s %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template></Upper>
</Font>
