<!-- Battery candle. Body outline+wicks fixed; fill height/y driven live by
     [BATTERY_PERCENT] via Transform. Colour bands per locked design: >50 cyan,
     20-50 amber, <20 red.
     Sizing/position set by Ambar 2026-07-29: body -20% (40x90 -> 32x72),
     moved up by half the new body length (36px) and left by one new body
     width (32px): PartDraw origin (65,245) -> (33,209).
     Wicks added - the first pass omitted them entirely (candlestick design
     calls for protrusions above/below the body, width = 5x outline thickness
     per the original PNG design: 2px outline -> 10px wick, scaled by the same
     -20% -> 8px). Wicks are structural, not threshold-coloured, so they sit
     in the same static PartDraw as the outline rather than duplicated across
     three Condition branches.

     STRUCTURAL NOTE: PartDraw's content model is DrawElement only (Rectangle/
     Ellipse/Line/Arc). Condition, PartText etc. are NOT valid PartDraw children -
     nesting them there fails silently (invalid children are dropped, no error,
     no crash), which cost a cycle. Condition and PartText must be siblings of
     PartDraw, both living directly under this Group. -->
<!-- Coordinate frame for every PartDraw below: box is x=33,y=195,w=32,h=100 -
     tall enough to contain wick(14) + body(72) + wick(14) with NO negative
     local coordinates, since it's unconfirmed whether PartDraw clips children
     to its own declared box (safer not to rely on content escaping it). Local
     y=14 is the body top, y=86 is the body bottom, throughout. -->
<Group x="0" y="0" width="450" height="450" name="battery_group">
<PartDraw x="33" y="195" width="32" height="100">
<Rectangle x="12" y="0" width="8" height="14">
<Fill color="#ff888888"/>
</Rectangle>
<Rectangle x="0" y="14" width="32" height="72">
<Stroke color="#ff888888" thickness="2"/>
</Rectangle>
<Rectangle x="12" y="86" width="8" height="14">
<Fill color="#ff888888"/>
</Rectangle>
</PartDraw>
<Condition>
<Expressions>
<Expression name="batt_hi">[BATTERY_PERCENT] - 50</Expression>
</Expressions>
<Compare expression="batt_hi">
<PartDraw x="33" y="195" width="32" height="100">
<Rectangle x="2" y="84" width="28" height="0">
<Transform target="height" value="68 * [BATTERY_PERCENT] / 100"/>
<Transform target="y" value="84 - (68 * [BATTERY_PERCENT] / 100)"/>
<Fill color="#ff00e5ff"/>
</Rectangle>
</PartDraw>
</Compare>
<Default>
<Condition>
<Expressions>
<Expression name="batt_mid">[BATTERY_PERCENT] - 20</Expression>
</Expressions>
<Compare expression="batt_mid">
<PartDraw x="33" y="195" width="32" height="100">
<Rectangle x="2" y="84" width="28" height="0">
<Transform target="height" value="68 * [BATTERY_PERCENT] / 100"/>
<Transform target="y" value="84 - (68 * [BATTERY_PERCENT] / 100)"/>
<Fill color="#ffFF9520"/>
</Rectangle>
</PartDraw>
</Compare>
<Default>
<PartDraw x="33" y="195" width="32" height="100">
<Rectangle x="2" y="84" width="28" height="0">
<Transform target="height" value="68 * [BATTERY_PERCENT] / 100"/>
<Transform target="y" value="84 - (68 * [BATTERY_PERCENT] / 100)"/>
<Fill color="#ffFF4444"/>
</Rectangle>
</PartDraw>
</Default>
</Condition>
</Default>
</Condition>
<PartText x="33" y="233" width="32" height="20">
<Text align="CENTER" ellipsis="FALSE">
<Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" slant="NORMAL" color="#ffffffff">
<Template>%s<Parameter expression="[BATTERY_PERCENT]"/></Template>
