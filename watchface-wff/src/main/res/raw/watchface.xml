<Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" slant="NORMAL" color="#ffffffff">
<Template>%s<Parameter expression="[BATTERY_PERCENT]"/></Template>
</Font>
</Text>
</PartText>
