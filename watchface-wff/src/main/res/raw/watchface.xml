<DefaultProviderPolicy primaryProvider="com.reddoor3.forexdial/com.reddoor3.forexdial.wear.complication.EurUsdComplicationService" primaryProviderType="SMALL_IMAGE" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY"/>
<BoundingBox x="0" y="0" width="432" height="150"/>
<Complication type="SMALL_IMAGE">
<PartImage x="0" y="0" width="432" height="150" alpha="255">
