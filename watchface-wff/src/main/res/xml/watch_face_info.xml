<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the picker preview. Attributes are deliberately un-namespaced:
     dumping the working face on this watch shows plain `value=`, not
     `android:value=`. -->
<WatchFaceInfo>
    <Preview value="@drawable/preview"/>
    <MultipleInstancesAllowed value="true"/>
    <Editable value="true"/>
</WatchFaceInfo>
